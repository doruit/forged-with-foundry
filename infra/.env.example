# ---------------------------------------------------------------------------
# Azure / deployment settings (used by infra/deploy.sh)
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-forged-with-foundry
AZURE_LOCATION=swedencentral

# Foundry account + default project
FOUNDRY_ACCOUNT_NAME=foundry-gov-demo
FOUNDRY_PROJECT_NAME=default-project
FOUNDRY_PROJECT_DISPLAY_NAME=Governance Controls Demo

# Deterministic PII enforcement (names must be globally unique)
AZURE_LANGUAGE_ACCOUNT_NAME=foundry-gov-demo-language
PII_STORAGE_ACCOUNT_NAME=foundrygovdemopii
PII_SOURCE_CONTAINER=pii-source
PII_TARGET_CONTAINER=pii-redacted

# Model deployment capacities (thousands of tokens per minute)
GPT5_CAPACITY=50
GPT5_MINI_CAPACITY=50
EMBEDDING_CAPACITY=50

# ---------------------------------------------------------------------------
# Populated automatically by infra/deploy.sh after a successful deployment
# ---------------------------------------------------------------------------
# Azure AI Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Azure AI Content Safety / AI Services endpoint
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.services.ai.azure.com/

# Model deployment names (used by evaluators and control implementations)
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Language and native Document PII
AZURE_LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/
PII_STORAGE_BLOB_ENDPOINT=https://<your-storage-account>.blob.core.windows.net/
PII_DOCUMENT_API_VERSION=2026-05-01
PII_DOCUMENT_POLL_SECONDS=2
PII_DOCUMENT_TIMEOUT_SECONDS=120
PII_ESCALATION_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Control thresholds
# ---------------------------------------------------------------------------
# Groundedness alert threshold (score out of 5)
GROUNDEDNESS_THRESHOLD=3.0
