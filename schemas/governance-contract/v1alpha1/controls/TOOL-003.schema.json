{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOOL-003 declaration: approved tool-call budget per task type",
  "description": "Human-approved tool-call budgets that the TOOL-003 runtime reads before ACS evaluates any tool call. Validation proves the declaration is structurally complete, not that a budget is the right number or that every tool call reaches the ACS boundary.",
  "type": "object",
  "required": [
    "id",
    "version",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "TOOL-003"
    },
    "version": {
      "const": "1.0.0"
    },
    "evidence": {
      "type": "object",
      "required": [
        "taskBudgets",
        "reviewRef",
        "reviewedOn",
        "accountableRole"
      ],
      "additionalProperties": false,
      "properties": {
        "taskBudgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "taskType",
              "maxToolCalls"
            ],
            "additionalProperties": false,
            "properties": {
              "taskType": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "maxToolCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "extension": {
                "description": "Optional human-approved continuation. When the budget is reached, ACS escalates to the accountable role, who may approve up to maxExtraToolCalls more calls for that one run within approvalTtlSeconds. Without this block an over-budget call is denied.",
                "type": "object",
                "required": [
                  "maxExtraToolCalls",
                  "approvalTtlSeconds"
                ],
                "additionalProperties": false,
                "properties": {
                  "maxExtraToolCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "approvalTtlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 1800
                  }
                }
              }
            }
          }
        },
        "reviewRef": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "accountableRole": {
          "const": "AI Ops Lead"
        }
      }
    }
  }
}
