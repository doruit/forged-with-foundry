{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOOL-003 declaration: approved tool-call budget per task type",
  "description": "Human-approved tool-call budgets that the TOOL-003 runtime reads before ACS evaluates any tool call. Validation proves the declaration is structurally complete, not that a budget is the right number or that every tool call reaches the ACS boundary.",
  "type": "object",
  "required": ["id", "version", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "TOOL-003"
    },
    "version": {
      "const": "1.0.0"
    },
    "evidence": {
      "type": "object",
      "required": ["taskBudgets", "reviewRef", "reviewedOn", "accountableRole"],
      "additionalProperties": false,
      "properties": {
        "taskBudgets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["taskType", "maxToolCalls"],
            "additionalProperties": false,
            "properties": {
              "taskType": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "maxToolCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            }
          }
        },
        "reviewRef": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "accountableRole": {
          "const": "AI Ops Lead"
        }
      }
    }
  }
}
