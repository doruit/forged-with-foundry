{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUT-004 declaration: emergency stop scope",
  "description": "Declares which agent action an operator can stop and which App Configuration feature flag is the authoritative stop switch. Validation proves the declaration is structurally complete, not that every protected call reaches the ACS boundary or that a stop has ever been exercised.",
  "type": "object",
  "required": ["id", "version", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "const": "AUT-004" },
    "version": { "const": "1.0.0" },
    "evidence": {
      "type": "object",
      "required": ["stopScopes", "failureMode", "reviewRef", "reviewedOn", "accountableRole"],
      "additionalProperties": false,
      "properties": {
        "stopScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["toolName", "flagName"],
            "additionalProperties": false,
            "properties": {
              "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "flagName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$" }
            }
          }
        },
        "failureMode": { "const": "stop_unless_enabled" },
        "reviewRef": { "type": "string", "pattern": "^\\S+$" },
        "reviewedOn": { "type": "string", "format": "date" },
        "accountableRole": { "const": "Ops Manager" }
      }
    }
  }
}
