# DAT-PRE-002 deployment inputs — no Azure resources; Microsoft Graph / Microsoft 365 only.

# One-time prerequisite: register a public-client Microsoft Entra app with delegated
# Graph permissions Files.ReadWrite.All + User.Read (admin consent if your tenant requires
# it), and enable "Allow public client flows". See README.md "Prerequisites" for steps.
DAT_PRE_002_ENTRA_CLIENT_ID=<entra-app-client-id>
# Use a specific tenant GUID for single-tenant apps, or leave as "organizations" for multi-tenant.
DAT_PRE_002_ENTRA_TENANT_ID=organizations

# GUIDs of two already-published sensitivity labels in your tenant (find them via the
# Microsoft Purview portal label URL, or `Get-Label | Select-Object Name, ImmutableId`
# in Security & Compliance PowerShell). Any two distinct labels work; name them here only
# for your own reference.
DAT_PRE_002_CONFIDENTIAL_LABEL_ID=<confidential-label-guid>
DAT_PRE_002_PUBLIC_LABEL_ID=<public-label-guid>
