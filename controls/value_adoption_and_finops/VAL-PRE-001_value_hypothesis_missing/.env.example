# Reuse values from ../../../infra/.env, or set them here.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral

VALPRE001_POLICY_DEFINITION_NAME=val-pre-001-value-hypothesis-gate
VALPRE001_POLICY_ASSIGNMENT_NAME=val-pre-001-value-hypothesis-gate-assignment
VALPRE001_DEMO_RESOURCE_NAME=valpre001-demo

# Populated by infra/deploy.sh.
VALPRE001_POLICY_DEFINITION_ID=
VALPRE001_POLICY_ASSIGNMENT_ID=

# Optional: only needed to run infra/deploy-oidc.sh and the real GitHub Actions
# demo (.github/workflows/val-pre-001-value-gate-demo.yml). Not required for the
# core demo.sh / infra/deploy.sh path.
VALPRE001_GITHUB_REPOSITORY=doruit/forged-with-foundry
VALPRE001_GITHUB_ENVIRONMENT=production
VALPRE001_OIDC_IDENTITY_NAME=id-val-pre-001-github-oidc

# Optional override: deploy-oidc.sh derives the current GitHub OIDC subject
# automatically via 'gh api' (requires the GitHub CLI, authenticated). Set
# this only if 'gh' is unavailable and you already know the exact subject
# (see docs/OIDC-DEMO.md).
VALPRE001_GITHUB_OIDC_SUBJECT=

# Populated by infra/deploy-oidc.sh.
VALPRE001_OIDC_CLIENT_ID=
