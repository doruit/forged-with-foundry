<mxfile host="app.diagrams.net">
  <diagram name="VAL-001 demo infrastructure setup (simplified)" id="val-001-architecture">
    <mxGraphModel dx="800" dy="600" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer frame, drawn first (behind everything); the export crops
             to content bounds, so this also sets the image's margin -->
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="960" height="370" as="geometry" />
        </mxCell>

        <!-- The only deployment boundary kept: everything else in this
             simplified view is the causal chain, not a hosting detail -->
        <mxCell id="group-foundry" value="" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A855F7;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="260" height="220" as="geometry" />
