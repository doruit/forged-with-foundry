             causal chain, not a hosting detail. -->
        <mxCell id="group-foundry" value="" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A855F7;dashed=1;verticalAlign=top;" vertex="1" parent="1">
