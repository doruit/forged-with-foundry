<mxfile host="app.diagrams.net">
  <diagram name="QLT-001 infrastructure architecture" id="qlt-001-architecture">
    <mxGraphModel dx="900" dy="600" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer frame, drawn first (behind everything); the export crops
             to content bounds, so this also sets the image's margin -->
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="900" height="300" as="geometry" />
        </mxCell>

        <!-- Foundry project boundary: the fleet and Continuous Evaluation
