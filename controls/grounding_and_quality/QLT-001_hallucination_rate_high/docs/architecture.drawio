<mxfile host="app.diagrams.net">
  <diagram name="QLT-001 infrastructure architecture" id="qlt-001-architecture">
    <mxGraphModel dx="800" dy="600" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer frame, drawn first (behind everything); the export crops
             to content bounds, so this also sets the image's margin -->
        <mxCell id="frame" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="740" height="260" as="geometry" />
        </mxCell>

        <!-- The only deployment boundary kept: everything else in this
             simplified view is the causal chain, not a hosting detail -->
        <mxCell id="group-foundry" value="" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A855F7;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="badge-foundry" value="" style="shape=image;image=icon:../../../../media/icons/Azure_Public_Service_Icons/Icons/ai + machine learning/035746832-icon-service-AI-Foundry.svg;" vertex="1" parent="1">
